# Example local proxy profile for forwarding to a Dynamo/SGLang server.

export LLM_PROXY_PROVIDER=custom
export LLM_PROXY_UPSTREAM_BASE_URL="http://my-dynamo-server:8000"
export LLM_PROXY_UPSTREAM_AUTH_MODE=none
export LLM_PROXY_CAPTURE_MODE=safe
export LLM_PROXY_LOG_DIRECTORY="./logs/dynamo"
export LLM_PROXY_PORT=8789

python -m llm_traffic_inspector.run_proxy

