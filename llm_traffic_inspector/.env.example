# Local LLM Traffic Inspector example.
# Copy to .env only if you want a local convenience file.
# Do not commit real API keys.

LLM_PROXY_PROVIDER=openai
LLM_PROXY_UPSTREAM_BASE_URL=https://api.openai.com
LLM_PROXY_OPENAI_API_KEY=replace-with-real-openai-key
LLM_PROXY_CAPTURE_MODE=safe
LLM_PROXY_LOG_DIRECTORY=./logs
LLM_PROXY_BIND_HOST=127.0.0.1
LLM_PROXY_PORT=8787

# For Anthropic, use a separate terminal/profile:
# LLM_PROXY_PROVIDER=anthropic
# LLM_PROXY_UPSTREAM_BASE_URL=https://api.anthropic.com
# LLM_PROXY_ANTHROPIC_API_KEY=replace-with-real-anthropic-key
# LLM_PROXY_PORT=8788

# For OpenAI-compatible providers such as DeepSeek, Kimi, Qwen, or local servers:
# LLM_PROXY_PROVIDER=openai_compatible
# LLM_PROXY_UPSTREAM_BASE_URL=https://api.provider.example
# LLM_PROXY_UPSTREAM_AUTH_MODE=bearer
# LLM_PROXY_UPSTREAM_API_KEY=replace-with-real-provider-key

# For Dynamo/custom servers:
# LLM_PROXY_PROVIDER=custom
# LLM_PROXY_UPSTREAM_BASE_URL=http://127.0.0.1:8000
# LLM_PROXY_UPSTREAM_AUTH_MODE=none

